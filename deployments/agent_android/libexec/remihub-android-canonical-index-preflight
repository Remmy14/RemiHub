#!/usr/bin/env bash
set -Eeuo pipefail

CANONICAL_REPO='/opt/remihub-android'
EXPECTED_GIT_DIR='/opt/remihub-android/.git'
EXPECTED_BRANCH='master'
EXPECTED_OWNER='alex'
EXPECTED_GROUP='storage'
EXPECTED_MODE='600'

fail() {
  printf 'canonical_index_preflight=failed\n' >&2
  printf 'failure_reason=%s\n' "$1" >&2
  exit 1
}

[[ "${EUID}" -eq 0 ]] || fail 'must run as root'
[[ -d "$CANONICAL_REPO" ]] || fail 'canonical repository missing'
[[ ! -L "$CANONICAL_REPO" ]] || fail 'canonical repository is a symlink'
getent passwd "$EXPECTED_OWNER" >/dev/null || fail 'expected owner account missing'
getent group "$EXPECTED_GROUP" >/dev/null || fail 'expected group missing'

GIT_DIR="$({
  runuser -u "$EXPECTED_OWNER" -- env \
    HOME=/home/alex \
    XDG_CONFIG_HOME=/home/alex/.config \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_OPTIONAL_LOCKS=0 \
    git -c "safe.directory=${CANONICAL_REPO}" \
      -C "$CANONICAL_REPO" rev-parse --absolute-git-dir
} 2>/dev/null)" || fail 'unable to resolve canonical Git directory as alex'

[[ "$GIT_DIR" == "$EXPECTED_GIT_DIR" ]] || fail "unexpected canonical Git directory: $GIT_DIR"
[[ -d "$GIT_DIR" ]] || fail 'canonical Git directory missing'
[[ ! -L "$GIT_DIR" ]] || fail 'canonical Git directory is a symlink'
INDEX="$GIT_DIR/index"
[[ -f "$INDEX" ]] || fail 'canonical Git index missing'
[[ ! -L "$INDEX" ]] || fail 'canonical Git index is a symlink'
[[ "$(stat -c '%h' "$INDEX")" == '1' ]] || fail 'canonical Git index has unexpected hard-link count'
INDEX_REAL="$(readlink -f -- "$INDEX")"
[[ "$INDEX_REAL" == "$EXPECTED_GIT_DIR/index" ]] || fail 'canonical Git index resolved outside expected path'

BEFORE_SHA256="$(sha256sum "$INDEX" | awk '{print $1}')"
BEFORE_OWNER="$(stat -c '%U' "$INDEX")"
BEFORE_GROUP="$(stat -c '%G' "$INDEX")"
BEFORE_MODE="$(stat -c '%a' "$INDEX")"

if [[ "$BEFORE_OWNER" != "$EXPECTED_OWNER" || \
      "$BEFORE_GROUP" != "$EXPECTED_GROUP" || \
      "$BEFORE_MODE" != "$EXPECTED_MODE" ]]; then
  chown --no-dereference "$EXPECTED_OWNER:$EXPECTED_GROUP" "$INDEX"
  chmod --changes "$EXPECTED_MODE" "$INDEX"
fi

AFTER_SHA256="$(sha256sum "$INDEX" | awk '{print $1}')"
AFTER_OWNER="$(stat -c '%U' "$INDEX")"
AFTER_GROUP="$(stat -c '%G' "$INDEX")"
AFTER_MODE="$(stat -c '%a' "$INDEX")"
[[ "$AFTER_SHA256" == "$BEFORE_SHA256" ]] || fail 'canonical Git index bytes changed during metadata normalization'
[[ "$AFTER_OWNER" == "$EXPECTED_OWNER" ]] || fail 'canonical Git index owner normalization failed'
[[ "$AFTER_GROUP" == "$EXPECTED_GROUP" ]] || fail 'canonical Git index group normalization failed'
[[ "$AFTER_MODE" == "$EXPECTED_MODE" ]] || fail 'canonical Git index mode normalization failed'
runuser -u "$EXPECTED_OWNER" -- test -r "$INDEX" || fail 'alex cannot read canonical Git index'
runuser -u "$EXPECTED_OWNER" -- test -w "$INDEX" || fail 'alex cannot write canonical Git index'
for identity in remihub-agent remihub-deployer; do
  if getent passwd "$identity" >/dev/null; then
    if runuser -u "$identity" -- test -r "$INDEX"; then
      fail "$identity unexpectedly can read canonical Git index"
    fi
    if runuser -u "$identity" -- test -w "$INDEX"; then
      fail "$identity unexpectedly can write canonical Git index"
    fi
  fi
done

BRANCH="$({
  runuser -u "$EXPECTED_OWNER" -- env \
    HOME=/home/alex \
    XDG_CONFIG_HOME=/home/alex/.config \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_OPTIONAL_LOCKS=0 \
    git -c "safe.directory=${CANONICAL_REPO}" \
      -C "$CANONICAL_REPO" branch --show-current
} 2>/dev/null)" || fail 'unable to read canonical branch as alex'
[[ "$BRANCH" == "$EXPECTED_BRANCH" ]] || fail "unexpected canonical branch: $BRANCH"

STATUS="$({
  runuser -u "$EXPECTED_OWNER" -- env \
    HOME=/home/alex \
    XDG_CONFIG_HOME=/home/alex/.config \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_OPTIONAL_LOCKS=0 \
    git -c "safe.directory=${CANONICAL_REPO}" \
      -C "$CANONICAL_REPO" status --porcelain=v1 --untracked-files=all
} 2>/dev/null)" || fail 'unable to inspect canonical worktree as alex'
[[ -z "$STATUS" ]] || fail 'canonical Android worktree is dirty'

HEAD="$({
  runuser -u "$EXPECTED_OWNER" -- env \
    HOME=/home/alex \
    XDG_CONFIG_HOME=/home/alex/.config \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_OPTIONAL_LOCKS=0 \
    git -c "safe.directory=${CANONICAL_REPO}" \
      -C "$CANONICAL_REPO" rev-parse HEAD
} 2>/dev/null)" || fail 'unable to resolve canonical HEAD as alex'

printf 'canonical_index_preflight=passed\n'
printf 'canonical_head=%s\n' "$HEAD"
printf 'canonical_branch=%s\n' "$BRANCH"
printf 'index_path=%s\n' "$INDEX"
printf 'index_sha256=%s\n' "$AFTER_SHA256"
printf 'index_owner_before=%s\n' "$BEFORE_OWNER"
printf 'index_group_before=%s\n' "$BEFORE_GROUP"
printf 'index_mode_before=%s\n' "$BEFORE_MODE"
printf 'index_owner_after=%s\n' "$AFTER_OWNER"
printf 'index_group_after=%s\n' "$AFTER_GROUP"
printf 'index_mode_after=%s\n' "$AFTER_MODE"
