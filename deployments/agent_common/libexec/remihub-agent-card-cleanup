#!/usr/bin/python3
"""Fixed-boundary manual-close cleanup. Never writes the application database."""
from __future__ import annotations
import argparse
from contextlib import ExitStack, contextmanager
from dataclasses import dataclass
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import time
from uuid import UUID

CONFIG = Path('/etc/remihub-agent-card-cleanup.json')
STATE = Path('/var/lib/remihub-agent/card-cleanup')
ACTIVE = {'queued', 'claimed', 'running', 'blocked'}
SQL = """BEGIN READ ONLY; SET LOCAL statement_timeout='10s';
SELECT json_build_object('cards',(SELECT COALESCE(json_agg(t),'[]') FROM
 (SELECT c.id,c.status,c.repository_scope,c.worktree_path,c.closed_at,
 EXISTS(SELECT 1 FROM agent.events e WHERE e.card_id=c.id AND e.event_type='card.closed'
 AND e.actor_type='user' AND e.actor_user_id IS NOT NULL AND e.created_at=c.closed_at) AS manual_close_exact
 FROM agent.cards c) t), 'runs',(SELECT COALESCE(json_agg(t),'[]') FROM
 (SELECT card_id,phase,status FROM agent.runs WHERE status IN ('queued','claimed','running','blocked'))t));
COMMIT;"""

@dataclass(frozen=True)
class Surface:
    name: str
    owner: str
    scope: str
    repository: Path
    root: Path
    implementation: bool = False

SURFACES = (
 Surface('backend-implementation','remihub-agent','backend',Path('/opt/remihub-agent/repositories/remihub-implementation.git'),Path('/opt/remihub-agent/implementation/worktrees'),True),
 Surface('android-implementation','remihub-agent','android',Path('/opt/remihub-agent/repositories/remihub-android-implementation.git'),Path('/opt/remihub-agent/android/implementation/worktrees'),True),
 Surface('backend-qa','remihub-deployer','backend',Path('/opt/remihub-agent/deployment/qa/repository.git'),Path('/opt/remihub-agent/deployment/qa/worktrees')),
 Surface('backend-production','remihub-deployer','backend',Path('/opt/remihub-agent/deployment/production/repository.git'),Path('/opt/remihub-agent/deployment/production/worktrees')),
 Surface('android-deployment','remihub-deployer','android',Path('/opt/remihub-agent/android/deployment/repository.git'),Path('/opt/remihub-agent/android/deployment/worktrees')),
)

class Deferred(Exception): pass

def canonical_id(value):
    if str(UUID(value)) != value: raise Deferred('noncanonical card ID')
    return value

def no_symlinks(path):
    path = Path(path)
    if not path.is_absolute(): raise Deferred('relative path')
    for part in [*reversed(path.parents), path]:
        try:
            if stat.S_ISLNK(part.lstat().st_mode): raise Deferred('symlink path component')
        except FileNotFoundError: raise Deferred('missing path component')
    return path

def secure_root_file(path):
    no_symlinks(path)
    st=path.stat()
    if st.st_uid != 0 or st.st_mode & 0o022 or not stat.S_ISREG(st.st_mode):
        raise Deferred('configuration must be a root-owned, nonwritable regular file')

def read_policy():
    secure_root_file(CONFIG)
    policy=json.loads(CONFIG.read_text())
    if set(policy) != {'enabled','automatic_since','historical_cards','hold_cards','hold_paths','max_resources'}:
        raise Deferred('unknown or incomplete policy')
    for key in ('historical_cards','hold_cards'):
        if not isinstance(policy[key],list):raise Deferred('invalid card policy')
        for value in policy[key]:canonical_id(value)
    datetime.fromisoformat(policy['automatic_since'])
    if not isinstance(policy['enabled'],bool) or type(policy['max_resources']) is not int or not 1 <= policy['max_resources'] <= 10:
        raise Deferred('invalid cleanup budget')
    if not isinstance(policy['hold_paths'],list) or any(not isinstance(p,str) or not p.startswith('/') for p in policy['hold_paths']):raise Deferred('invalid retention paths')
    return policy

def database():
    # Fixed read-only SQL, local peer authentication, no credentials or arbitrary queries.
    result=subprocess.run(['/usr/sbin/runuser','-u','postgres','--','/usr/bin/psql','-X','-qAt','-v','ON_ERROR_STOP=1','-d','remihub','-f','-'],input=SQL,text=True,capture_output=True,timeout=20,check=True,env={'PATH':'/usr/bin:/bin','HOME':'/nonexistent'})
    return json.loads(result.stdout)

def git(surface, cwd, *args):
    env={'PATH':'/usr/bin:/bin','HOME':'/nonexistent','GIT_CONFIG_NOSYSTEM':'1','GIT_CONFIG_GLOBAL':'/dev/null','GIT_OPTIONAL_LOCKS':'0','GIT_TERMINAL_PROMPT':'0'}
    return subprocess.run(['/usr/sbin/runuser','-u',surface.owner,'--','/usr/bin/env',*[k+'='+v for k,v in env.items()],'/usr/bin/git','-c','core.fsmonitor=false','-c','core.hooksPath=/dev/null','-c','core.untrackedCache=false','-C',str(cwd),*args],capture_output=True,check=True,timeout=120).stdout

def registrations(surface):
    no_symlinks(surface.repository);no_symlinks(surface.root)
    raw=git(surface,surface.repository,'worktree','list','--porcelain','-z')
    entries=[];entry={}
    for record in raw.split(b'\0'):
        if not record:
            if entry:entries.append(entry);entry={}
        else:
            key,_,value=record.partition(b' ');entry[key.decode()]=os.fsdecode(value)
    if entry:entries.append(entry)
    return entries

def identity(surface, entry):
    path=Path(entry['worktree'])
    if path.parent != surface.root:raise Deferred('outside exact cleanup boundary')
    pattern=r'card-([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})' + ('' if surface.implementation else r'-r([1-9][0-9]*)')
    match=re.fullmatch(pattern,path.name)
    if not match:raise Deferred('unrecognized resource name')
    card_id=canonical_id(match[1])
    branch='refs/heads/'+('agent/card-'+card_id if surface.implementation else 'deployment/card-'+card_id+'/r'+match[2])
    if entry.get('branch') != branch:raise Deferred('unexpected branch association')
    if 'locked' in entry or 'prunable' in entry:raise Deferred('locked or stale Git registration')
    return card_id,path,branch

def card_eligible(surface, card_id, path, db, policy, historical=False):
    card=next((c for c in db['cards'] if c['id']==card_id),None)
    if not card or card['status']!='closed' or not card['manual_close_exact'] or not card['closed_at']:
        raise Deferred('no verified manual closure; retain Open/unresolved cards')
    if card['repository_scope'] != surface.scope:raise Deferred('repository scope mismatch')
    if surface.implementation and card.get('worktree_path') != str(path):raise Deferred('persisted implementation ownership mismatch')
    if any(c['id']!=card_id and c.get('worktree_path')==str(path) for c in db['cards']):raise Deferred('shared cross-card association')
    if any(r['card_id']==card_id and r['status'] in ACTIVE for r in db['runs']):raise Deferred('active or retryable run')
    if card_id in policy['hold_cards']:raise Deferred('explicit card retention hold')
    for held in policy['hold_paths']:
        h=Path(held)
        if path==h or path in h.parents or h in path.parents:raise Deferred('explicit path retention hold')
    after=datetime.fromisoformat(card['closed_at']) >= datetime.fromisoformat(policy['automatic_since'])
    if not after and card_id not in policy['historical_cards'] and not historical:
        raise Deferred('historical cleanup not enabled for this card')
    return card

def ignored_disposable(name):
    p=Path(name)
    if p.is_absolute() or '..' in p.parts:return False
    # Reproducible per-worktree outputs only; unknown ignored files are retained.
    prefixes=('build/','app/build/','.gradle/','frontend-web/node_modules/','frontend-web/dist/','.pytest_cache/')
    return name.startswith(prefixes) or ('__pycache__' in p.parts and p.suffix=='.pyc')

def verify_worktree(surface, entry, path, branch):
    no_symlinks(path)
    if path.stat().st_uid != pwd.getpwnam(surface.owner).pw_uid:raise Deferred('wrong filesystem owner')
    dotgit=path/'.git'
    if dotgit.is_symlink() or not dotgit.is_file():raise Deferred('invalid linked worktree marker')
    common=Path(os.fsdecode(git(surface,path,'rev-parse','--path-format=absolute','--git-common-dir')).strip())
    if common != surface.repository:raise Deferred('wrong common Git directory')
    if git(surface,path,'symbolic-ref','HEAD').decode().strip()!=branch:raise Deferred('worktree branch changed')
    head=git(surface,path,'rev-parse','HEAD').decode().strip()
    if head!=entry['HEAD'] or git(surface,surface.repository,'rev-parse',branch).decode().strip()!=head:raise Deferred('HEAD or preserved branch changed')
    if git(surface,path,'status','--porcelain=v1','--untracked-files=all','--ignore-submodules=none').strip():raise Deferred('dirty or unpreserved changes')
    ignored=git(surface,path,'ls-files','--others','--ignored','--exclude-standard','-z').split(b'\0')
    if any(not ignored_disposable(os.fsdecode(p)) for p in ignored if p):raise Deferred('unclassified ignored files')
    if (path/'.gitmodules').exists():
        raise Deferred('submodule worktree requires manual inspection')
    st=path.stat();return st.st_dev,st.st_ino

def process_use(path):
    prefix=str(path)+'/'
    def inside(value):return value==str(path) or value.startswith(prefix)
    for proc in Path('/proc').iterdir():
        if not proc.name.isdecimal():continue
        try:
            for name in ('cwd','root','exe'):
                try:
                    if inside(os.readlink(proc/name).removesuffix(' (deleted)')):return True
                except FileNotFoundError:pass
            for fd in (proc/'fd').iterdir():
                try:
                    if inside(os.readlink(fd).removesuffix(' (deleted)')):return True
                except FileNotFoundError:pass
            for line in (proc/'maps').read_text().splitlines():
                parts=line.split(None,5)
                if len(parts)==6 and inside(parts[5].removesuffix(' (deleted)')):return True
        except (FileNotFoundError,ProcessLookupError):continue
        except PermissionError:raise Deferred('process visibility incomplete')
    return False

@contextmanager
def card_locks(card_id,surfaces,create=True):
    with ExitStack() as stack:
        for surface in sorted(surfaces,key=lambda s:str(s.root)):
            root=no_symlinks(surface.root/'.locks');path=root/(card_id+'.lock')
            if not create and not os.path.lexists(path):continue
            fd=os.open(path,(os.O_RDWR|os.O_CREAT if create else os.O_RDONLY)|os.O_NOFOLLOW,0o640)
            stack.callback(os.close,fd)
            owner=pwd.getpwnam(surface.owner)
            st=os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink!=1:raise Deferred('invalid worker lock')
            if create and st.st_uid==0:os.fchown(fd,owner.pw_uid,owner.pw_gid)
            elif st.st_uid!=owner.pw_uid:raise Deferred('wrong lock owner')
            try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
            except BlockingIOError:raise Deferred('workspace lock busy')
        yield

def atomic_json(path,value):
    temp=path.with_suffix('.pending')
    fd=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o600)
    with os.fdopen(fd,'w') as f:json.dump(value,f,sort_keys=True);f.flush();os.fsync(f.fileno())
    os.replace(temp,path)
    fd=os.open(path.parent,os.O_DIRECTORY);os.fsync(fd);os.close(fd)

def resource_state(path):
    if not path.exists():return {'resources':{}}
    secure_root_file(path);return json.loads(path.read_text())

def sweep(policy, *, dry_run=True,historical=False,surfaces=SURFACES,load_db=database,busy=process_use,state_root=STATE):
    snapshot=load_db();results=[];removed=0
    if not dry_run and not policy['enabled']:raise Deferred('cleanup disabled')
    for surface in surfaces:
        try:entries=registrations(surface)
        except Exception as exc:
            results.append({'surface':surface.name,'status':'deferred','reason':type(exc).__name__});continue
        for entry in entries:
            path=Path(entry['worktree'])
            if path.parent!=surface.root:continue
            report={'surface':surface.name,'path':str(path),'status':'deferred'}
            try:
                card_id,path,branch=identity(surface,entry);report['card_id']=card_id
                card_eligible(surface,card_id,path,snapshot,policy,historical=historical and dry_run)
                if not path.exists():raise Deferred('missing registered path; no destructive fallback/prune')
                if not dry_run and removed>=policy['max_resources']:raise Deferred('batch budget; retry next tick')
                # Dry-run acquires existing locks too, but must not create/change any lock files.
                if dry_run:
                    with card_locks(card_id,[s for s in surfaces if s.scope==surface.scope],create=False):
                        verify_worktree(surface,entry,path,branch)
                        if busy(path):raise Deferred('resource in use by process')
                    report['estimated_allocated_bytes']=int(subprocess.check_output(['/usr/bin/du','-sx','--block-size=1',str(path)],timeout=30).split()[0])
                    report['status']='eligible';report['reason']='manual closure; clean registered worktree; history retained'
                else:
                    with card_locks(card_id,[s for s in surfaces if s.scope==surface.scope]):
                        card_eligible(surface,card_id,path,load_db(),policy)
                        current=next((e for e in registrations(surface) if e['worktree']==str(path)),None)
                        if current!=entry:raise Deferred('Git registration changed')
                        token=verify_worktree(surface,entry,path,branch)
                        if busy(path):raise Deferred('resource in use by process')
                        report['estimated_allocated_bytes']=int(subprocess.check_output(['/usr/bin/du','-sx','--block-size=1',str(path)],timeout=30).split()[0])
                        state_path=state_root/(card_id+'.json');state=resource_state(state_path)
                        state['resources'][str(path)]={'status':'in_progress','head':entry['HEAD'],'branch':branch,'updated_at':datetime.now(timezone.utc).isoformat()}
                        atomic_json(state_path,state)
                        card_eligible(surface,card_id,path,load_db(),policy)
                        if verify_worktree(surface,entry,path,branch)!=token:raise Deferred('path identity changed')
                        git(surface,surface.repository,'worktree','remove',str(path))
                        if os.path.lexists(path) or any(e['worktree']==str(path) for e in registrations(surface)):raise Deferred('removal incomplete')
                        if git(surface,surface.repository,'rev-parse',branch).decode().strip()!=entry['HEAD']:raise Deferred('retained branch changed')
                        state['resources'][str(path)]['status']='completed';atomic_json(state_path,state)
                        report['status']='removed';report['reason']='Git-native removal; branch retained';removed+=1
            except (Deferred,FileNotFoundError) as exc:report['reason']=str(exc)
            except Exception as exc:report['status']='failed';report['reason']=type(exc).__name__
            if not dry_run and report.get('card_id') and any(c['id']==report['card_id'] and c['status']=='closed' and c['manual_close_exact'] for c in snapshot['cards']):
                state_path=state_root/(report['card_id']+'.json');state=resource_state(state_path)
                prior=state['resources'].get(str(path),{})
                merged={**prior,**report,'updated_at':datetime.now(timezone.utc).isoformat()}
                if prior.get('status')=='in_progress' and report['status']!='removed':
                    merged['status']='in_progress';merged['last_attempt_status']=report['status']
                state['resources'][str(path)]=merged
                atomic_json(state_path,state)
            results.append(report)
    return results

def recover_intents(state_root, surfaces):
    # A crash after Git removal must not leave in_progress forever or recreate resources.
    known={str(s.root):s for s in surfaces}
    for p in state_root.glob('*.json'):
        if p.name=='latest.json':continue
        canonical_id(p.stem)
        state=resource_state(p);changed=False
        for name,record in state['resources'].items():
            if record.get('status')!='in_progress':continue
            surface=known.get(str(Path(name).parent))
            if surface is None:continue
            if not os.path.lexists(name) and not any(e['worktree']==name for e in registrations(surface)):
                if git(surface,surface.repository,'rev-parse',record['branch']).decode().strip()==record['head']:
                    record['status']='completed';record['recovered']=True;changed=True
        if changed:atomic_json(p,state)

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run',action='store_true');parser.add_argument('--historical',action='store_true');parser.add_argument('--sweep',action='store_true')
    args=parser.parse_args()
    if os.geteuid()!=0:parser.error('root required for fixed-account operations')
    if args.sweep==args.dry_run:parser.error('choose exactly --sweep or --dry-run')
    if args.historical and not args.dry_run:parser.error('historical removal requires reviewed policy card allowlist')
    policy=read_policy()
    if args.sweep:
        no_symlinks(STATE);st=STATE.stat()
        if st.st_uid!=0 or stat.S_IMODE(st.st_mode)!=0o700:raise Deferred('unsafe state directory')
        fd=os.open(STATE/'sweep.lock',os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600)
        try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:return
        recover_intents(STATE,SURFACES)
    before=os.statvfs('/');started=datetime.now(timezone.utc).isoformat()
    results=sweep(policy,dry_run=args.dry_run,historical=args.historical)
    after=os.statvfs('/');report={'started_at':started,'finished_at':datetime.now(timezone.utc).isoformat(),'trigger':'manual-card-closure-reconciliation','dry_run':args.dry_run,'estimated_removed_bytes':sum(r.get('estimated_allocated_bytes',0) for r in results if r['status']=='removed'),'resources':results,'filesystem_free_bytes_delta':(after.f_bavail-before.f_bavail)*after.f_frsize,'measurement_note':'Concurrent filesystem activity affects free-space delta; not exact reclaimed bytes'}
    if args.sweep:atomic_json(STATE/'latest.json',report)
    print(json.dumps(report,sort_keys=True))

if __name__=='__main__':
    try:main()
    except Exception as exc:
        print(json.dumps({'status':'failed','reason':type(exc).__name__}),flush=True);raise SystemExit(1)
