[Unit]
Description=Watch for backend production deployment wake requests
Documentation=file:///opt/remihub/deployments/agent_common/hardening/deployment-worker-trigger.md

[Path]
PathExists=/run/remihub-agent/deployment-trigger/backend-production.request
Unit=remihub-agent-backend-production-deployment-trigger.service

[Install]
WantedBy=multi-user.target
