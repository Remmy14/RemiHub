[Unit]
Description=RemiHub Android Deployment Queue Fallback Poll
Documentation=file:///opt/remihub/deployments/agent_common/hardening/deployment-worker-trigger.md

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=5s
Persistent=true
Unit=remihub-agent-android-deployment.service

[Install]
WantedBy=timers.target
