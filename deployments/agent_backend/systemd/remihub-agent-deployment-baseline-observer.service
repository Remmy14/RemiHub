[Unit]
Description=RemiHub Backend Deployment Baseline Observer (Run Once)
Documentation=file:///usr/local/share/doc/remihub-agent/backend-deployment-executor.md
ConditionFileIsExecutable=/usr/local/libexec/remihub-backend-deployment-baseline-observer
ConditionPathIsDirectory=/opt/remihub
ConditionPathIsDirectory=/opt/remihub-agent/repositories/remihub-planning
ConditionPathIsDirectory=/opt/remihub-agent/repositories/remihub-implementation.git
ConditionPathIsDirectory=/opt/remihub-agent/deployment/qa/repository.git
ConditionPathIsDirectory=/opt/remihub-agent/deployment/qa/application
ConditionPathIsDirectory=/opt/remihub-agent/deployment/production/repository.git

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/remihub-backend-deployment-baseline-observer
TimeoutStartSec=30s
KillMode=control-group
Restart=no
UMask=0027

Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_CONFIG_GLOBAL=/dev/null
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_OPTIONAL_LOCKS=0

# The observer is still fixed-purpose and tightly sandboxed, but it must use
# runuser for read-only probes under alex, remihub-agent, and remihub-deployer.
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_READ_SEARCH
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/remihub
ReadOnlyPaths=/opt/remihub-agent/repositories/remihub-planning
ReadOnlyPaths=/opt/remihub-agent/repositories/remihub-implementation.git
ReadOnlyPaths=/opt/remihub-agent/deployment/qa/repository.git
ReadOnlyPaths=/opt/remihub-agent/deployment/qa/application
ReadOnlyPaths=/opt/remihub-agent/deployment/production/repository.git
ReadOnlyPaths=/var/lib/remihub-agent/github-sync/backend
ReadWritePaths=/var/lib/remihub-agent/health-observations/backend

[Install]
WantedBy=multi-user.target
