[Unit]
Description=RemiHub Backend Deployment Worker (Production, Run Once)
Documentation=file://@RELEASE@/docs/backend-deployment-executor.md
After=postgresql.service remihub.service
ConditionPathIsDirectory=@RELEASE@
ConditionPathIsDirectory=/opt/remihub
ConditionPathIsDirectory=/opt/remihub-agent/repositories/remihub-planning
ConditionPathIsDirectory=/opt/remihub-agent/repositories/remihub-implementation.git
ConditionPathIsDirectory=/opt/remihub-agent/implementation/worktrees
ConditionPathIsDirectory=/opt/remihub-agent/implementation/artifacts
ConditionPathIsDirectory=/opt/remihub-agent/deployment/production/repository.git
ConditionPathIsDirectory=/opt/remihub-agent/deployment/production/worktrees
ConditionPathIsDirectory=/opt/remihub-agent/deployment/production/artifacts
ConditionFileIsExecutable=/opt/remihub-agent/runtime/venv/bin/python
ConditionFileIsExecutable=/usr/bin/node
ConditionFileIsExecutable=/usr/bin/npm
ConditionFileIsExecutable=/usr/local/libexec/remihub-backend-validation-sandbox
ConditionFileIsExecutable=/usr/local/libexec/remihub-backend-deployment-control
ConditionFileIsExecutable=/usr/local/libexec/remihub-backend-github-sync-control
ConditionFileIsExecutable=@PG_DUMP@
ConditionFileIsExecutable=@PG_RESTORE@
ConditionPathExists=/opt/remihub-agent/deployment/config/git-safe-directory.ini
ConditionPathExists=/opt/remihub-agent/deployment/config/frontend-web-policy.json
ConditionPathExists=/opt/remihub-agent/deployment/config/qa-parity-reader.ini

[Service]
Type=oneshot
User=remihub-deployer
Group=remihub-deployer
SupplementaryGroups=remihub-agent
WorkingDirectory=@RELEASE@
ExecStart=/opt/remihub-agent/runtime/venv/bin/python -m backend.agent_worker
TimeoutStartSec=30min
KillMode=control-group
Restart=no
UMask=0027

Environment=HOME=/nonexistent
Environment=PATH=/opt/remihub-agent/runtime/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=@RELEASE@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_CONFIG_GLOBAL=/opt/remihub-agent/deployment/config/git-safe-directory.ini
Environment=REMIHUB_DATABASE_CONFIG=/opt/remihub-agent/deployment/config/prod-worker.ini
Environment=REMIHUB_AGENT_ENVIRONMENT=production
Environment=REMIHUB_AGENT_EXECUTOR=git-backend-deployment
Environment=REMIHUB_AGENT_REPOSITORY=/opt/remihub-agent/repositories/remihub-implementation.git
Environment=REMIHUB_AGENT_WORKTREE_ROOT=/opt/remihub-agent/implementation/worktrees
Environment=REMIHUB_AGENT_ARTIFACT_ROOT=/opt/remihub-agent/implementation/artifacts
Environment=REMIHUB_AGENT_DEPLOYMENT_TARGET_REPOSITORY=/opt/remihub-agent/deployment/production/repository.git
Environment=REMIHUB_AGENT_DEPLOYMENT_WORKTREE_ROOT=/opt/remihub-agent/deployment/production/worktrees
Environment=REMIHUB_AGENT_DEPLOYMENT_ARTIFACT_ROOT=/opt/remihub-agent/deployment/production/artifacts
Environment=REMIHUB_AGENT_DEPLOYMENT_TARGET_BRANCH=production-main
Environment=REMIHUB_AGENT_DEPLOYMENT_DATABASE_CONFIG=/opt/remihub-agent/deployment/config/prod-migrator.ini
Environment=REMIHUB_AGENT_DEPLOYMENT_DATABASE_OWNER_ROLE=remihub
Environment=REMIHUB_AGENT_DEPLOYMENT_QA_PARITY_DATABASE_CONFIG=/opt/remihub-agent/deployment/config/qa-parity-reader.ini
Environment=REMIHUB_AGENT_DEPLOYMENT_PG_DUMP_BINARY=@PG_DUMP@
Environment=REMIHUB_AGENT_DEPLOYMENT_PG_RESTORE_BINARY=@PG_RESTORE@
Environment=REMIHUB_AGENT_DEPLOYMENT_BACKUP_ROOT=/var/backups/remihub-agent/backend-deployments/production
Environment=REMIHUB_AGENT_DEPLOYMENT_VALIDATOR=/usr/local/libexec/remihub-backend-validation-sandbox
Environment=REMIHUB_AGENT_DEPLOYMENT_RUNTIME_HELPER=/usr/local/libexec/remihub-backend-deployment-control
Environment=REMIHUB_AGENT_DEPLOYMENT_GITHUB_SYNC_HELPER=/usr/local/libexec/remihub-backend-github-sync-control
Environment=REMIHUB_AGENT_DEPLOYMENT_HEALTH_URL=http://127.0.0.1:8000/openapi.json
Environment=REMIHUB_AGENT_DEPLOYMENT_TIMEOUT_SECONDS=900
Environment=REMIHUB_AGENT_DEPLOYMENT_RETRY_SECONDS=60
Environment=REMIHUB_AGENT_WORKER_ID=remillard-serv-backend-deployment-production
Environment=REMIHUB_AGENT_RUN_ONCE=true
Environment=REMIHUB_AGENT_POLL_SECONDS=5
Environment=REMIHUB_AGENT_LEASE_SECONDS=120
Environment=REMIHUB_AGENT_HEARTBEAT_SECONDS=30
Environment=REMIHUB_AGENT_MAX_ATTEMPTS=3
Environment=REMIHUB_AGENT_GIT_TIMEOUT_SECONDS=120

NoNewPrivileges=false
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# Shared root-owned lock serializes backend promotion with Android release publication.
ReadWritePaths=/var/lib/remihub-agent/android-release
ProtectHome=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/opt/remihub
ReadWritePaths=/opt/remihub-agent/repositories/remihub-planning
ReadWritePaths=/opt/remihub-agent/repositories/remihub-implementation.git
ReadWritePaths=/opt/remihub-agent/deployment/production/repository.git
ReadWritePaths=/opt/remihub-agent/deployment/production/worktrees
ReadWritePaths=/opt/remihub-agent/deployment/production/artifacts
ReadWritePaths=/var/backups/remihub-agent/backend-deployments/production
ReadWritePaths=/var/backups/remihub-agent/frontend-web/production

[Install]
# Deliberately static. Start manually for one explicitly approved production deployment.
