[Unit]
Description=RemiHub Backend GitHub Synchronization (Run Once)
Documentation=file:///usr/local/share/doc/remihub-agent/backend-github-sync-runtime.md
After=network-online.target remihub.service
Wants=network-online.target
ConditionPathIsDirectory=/opt/remihub
ConditionPathIsDirectory=/var/lib/remihub-agent/github-sync/backend
ConditionPathIsDirectory=/run/remihub-agent/github-sync
ConditionPathIsDirectory=/etc/remihub-agent/github-sync/backend
ConditionFileIsExecutable=/usr/local/libexec/remihub-backend-github-sync
ConditionPathExists=/run/remihub-agent/github-sync/backend-request.json

[Service]
Type=oneshot
User=remihub-github-sync
Group=remihub-github-sync
SupplementaryGroups=storage
ExecStart=/usr/local/libexec/remihub-backend-github-sync
TimeoutStartSec=5min
KillMode=control-group
Restart=no
UMask=0077

Environment=HOME=/nonexistent
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_CONFIG_GLOBAL=/dev/null
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_OPTIONAL_LOCKS=0

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/remihub
ReadOnlyPaths=/etc/remihub-agent/github-sync/backend
ReadOnlyPaths=/run/remihub-agent/github-sync
ReadWritePaths=/var/lib/remihub-agent/github-sync/backend

[Install]
# Deliberately static. The protected root control helper starts this unit.
