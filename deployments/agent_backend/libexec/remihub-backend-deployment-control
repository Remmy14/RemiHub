#!/usr/bin/python3
"""Root-owned, fixed-path control boundary for RemiHub backend deployment."""
from __future__ import annotations

import grp
import hashlib
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from dataclasses import dataclass
from pathlib import Path

GIT = "/usr/bin/git"
SYSTEMCTL = "/usr/bin/systemctl"
RUNUSER = "/usr/sbin/runuser"
COMMIT_RE = re.compile(r"[0-9a-f]{40}")
BRANCH_RE = re.compile(
    r"deployment/card-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/r[1-9][0-9]*"
)
TAG_RE = re.compile(
    r"rollback-before-agent-card-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-r[1-9][0-9]*"
)
UUID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
)
IDENTITY_RE = re.compile(r"[0-9a-f]{64}")
FRONTEND_DIST_RELATIVE = Path("frontend-web/dist")
FRONTEND_ARCHIVE_MTIME = 0
FRONTEND_ARCHIVE_UID = 0
FRONTEND_ARCHIVE_GID = 0
FRONTEND_ARCHIVE_UNAME = "root"
FRONTEND_ARCHIVE_GNAME = "root"
FRONTEND_DIR_MODE = 0o755
FRONTEND_FILE_MODE = 0o644


@dataclass(frozen=True)
class Environment:
    service: str
    target_repo: Path
    target_branch: str
    runtime: Path
    runtime_branch: str
    runtime_user: str
    frontend_backup_root: Path


ENVIRONMENTS = {
    "qa": Environment(
        service="remihub-backend-qa.service",
        target_repo=Path("/opt/remihub-agent/deployment/qa/repository.git"),
        target_branch="qa-main",
        runtime=Path("/opt/remihub-agent/deployment/qa/application"),
        runtime_branch="qa-runtime",
        runtime_user="root",
        frontend_backup_root=Path("/opt/remihub-agent/deployment/qa/frontend-backups"),
    ),
    "production": Environment(
        service="remihub.service",
        target_repo=Path("/opt/remihub-agent/deployment/production/repository.git"),
        target_branch="production-main",
        runtime=Path("/opt/remihub"),
        runtime_branch="main",
        runtime_user="alex",
        frontend_backup_root=Path("/var/backups/remihub-agent/frontend-web/production"),
    ),
}
SOURCE_REPO = Path("/opt/remihub-agent/repositories/remihub-implementation.git")
PLANNING_REPO = Path("/opt/remihub-agent/repositories/remihub-planning")
GIT_SAFE_CONFIG = Path(
    "/opt/remihub-agent/deployment/config/git-safe-directory.ini"
)


def fail(message: str) -> "NoReturn":
    print(f"remihub-backend-deployment-control: {message}", file=sys.stderr)
    raise SystemExit(64)


def run(
    command: list[str],
    *,
    user: str | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    if user and user != "root":
        command = [RUNUSER, "--user", user, "--", *command]
    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        env={
            "HOME": "/root" if not user or user == "root" else f"/home/{user}",
            "LANG": "C.UTF-8",
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": str(GIT_SAFE_CONFIG),
            "GIT_TERMINAL_PROMPT": "0",
            "GIT_OPTIONAL_LOCKS": "0",
        },
    )
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()
        suffix = f": {detail[-1]}" if detail else ""
        fail(f"command failed{suffix}")
    return result


def git(repo: Path, *args: str, user: str | None = None) -> str:
    return run([GIT, "-C", str(repo), *args], user=user).stdout.strip()


def commit(value: str) -> str:
    if not COMMIT_RE.fullmatch(value):
        fail("invalid commit argument")
    return value


def uuid(value: str, *, field: str) -> str:
    if not UUID_RE.fullmatch(value):
        fail(f"invalid {field} argument")
    return value


def identity(value: str) -> str:
    if not IDENTITY_RE.fullmatch(value):
        fail("invalid artifact identity argument")
    return value


def branch(value: str) -> str:
    if not BRANCH_RE.fullmatch(value):
        fail("invalid candidate branch argument")
    return value


def tag(value: str) -> str:
    if not TAG_RE.fullmatch(value):
        fail("invalid rollback reference argument")
    return value


def verify_git_safe_config() -> None:
    try:
        stat_result = GIT_SAFE_CONFIG.stat()
    except OSError:
        fail("protected Git configuration is missing")
    if GIT_SAFE_CONFIG.is_symlink() or not GIT_SAFE_CONFIG.is_file():
        fail("protected Git configuration path is unsafe")
    if stat_result.st_uid != 0 or stat_result.st_mode & 0o022:
        fail("protected Git configuration ownership or mode is unsafe")


def verify_fixed_environment(environment_name: str) -> Environment:
    environment = ENVIRONMENTS.get(environment_name)
    if environment is None:
        fail("environment must be qa or production")
    for path in (environment.target_repo, environment.runtime):
        if not path.is_dir() or path.is_symlink():
            fail(f"required fixed path is missing or unsafe: {path}")
    return environment


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _canonical_json_bytes(value: object) -> bytes:
    return (
        json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
        + "\n"
    ).encode("utf-8")


def _frontend_manifest(path: Path) -> dict:
    if path.is_symlink() or not path.is_file():
        fail("frontend artifact manifest is missing or unsafe")
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("frontend artifact manifest is invalid")
    if not isinstance(manifest, dict) or not isinstance(manifest.get("entries"), list):
        fail("frontend artifact manifest is invalid")
    return manifest


def verify_frontend_archive(manifest_path: Path, archive_path: Path, expected_identity: str) -> dict:
    manifest = _frontend_manifest(manifest_path)
    if archive_path.is_symlink() or not archive_path.is_file():
        fail("frontend artifact archive is missing or unsafe")
    entries = manifest["entries"]
    names = []
    try:
        with tarfile.open(archive_path, "r:*") as archive:
            members = archive.getmembers()
            names = [member.name for member in members]
            if names != [entry.get("path") for entry in entries]:
                fail("frontend artifact archive entry order does not match manifest")
            for member, entry in zip(members, entries):
                relative = member.name
                if (
                    not relative
                    or relative.startswith("/")
                    or any(ord(character) < 32 for character in relative)
                    or ".." in Path(relative).parts
                ):
                    fail("frontend artifact archive contains an unsafe path")
                if member.mtime != FRONTEND_ARCHIVE_MTIME:
                    fail("frontend artifact archive has non-deterministic timestamps")
                if (
                    member.uid != FRONTEND_ARCHIVE_UID
                    or member.gid != FRONTEND_ARCHIVE_GID
                    or member.uname != FRONTEND_ARCHIVE_UNAME
                    or member.gname != FRONTEND_ARCHIVE_GNAME
                ):
                    fail("frontend artifact archive has non-deterministic ownership")
                if entry.get("type") == "directory":
                    if not member.isdir() or member.mode != FRONTEND_DIR_MODE:
                        fail("frontend artifact archive directory metadata mismatch")
                elif entry.get("type") == "file":
                    if not member.isfile() or member.mode != FRONTEND_FILE_MODE:
                        fail("frontend artifact archive file metadata mismatch")
                    if member.size != entry.get("size"):
                        fail("frontend artifact archive file size mismatch")
                    file_object = archive.extractfile(member)
                    if file_object is None:
                        fail("frontend artifact archive file cannot be read")
                    if hashlib.sha256(file_object.read()).hexdigest() != entry.get("sha256"):
                        fail("frontend artifact archive content mismatch")
                else:
                    fail("frontend artifact archive contains an unsupported entry type")
    except tarfile.TarError:
        fail("frontend artifact archive is invalid")
    identity_manifest = {
        key: manifest[key]
        for key in ("schema_version", "frontend_root", "candidate_commit", "lockfile_sha256", "entries")
    }
    observed_identity = hashlib.sha256(_canonical_json_bytes(identity_manifest)).hexdigest()
    if observed_identity != expected_identity or manifest.get("artifact_identity") != expected_identity:
        fail("frontend artifact identity does not match manifest")
    return {
        "status": "verified",
        "artifact_identity": observed_identity,
        "archive_sha256": _sha256_file(archive_path),
        "manifest_sha256": _sha256_file(manifest_path),
        "entry_count": len(names),
    }


def resolve(repo: Path, ref: str, *, user: str | None = None) -> str:
    value = git(repo, "rev-parse", "--verify", f"{ref}^{{commit}}", user=user)
    return commit(value)


def _parse_runtime_status(raw: str) -> tuple[tuple[str, str], ...]:
    if not raw:
        return ()
    if not raw.endswith("\0"):
        fail("Git runtime status is not NUL-terminated")
    fields = raw.split("\0")
    if fields[-1] != "":
        fail("Git runtime status has an invalid terminator")
    fields.pop()

    records: list[tuple[str, str]] = []
    index = 0
    while index < len(fields):
        record = fields[index]
        if len(record) < 4 or record[2] != " ":
            fail("Git runtime status contains an invalid record")
        status_code = record[:2]
        relative_text = record[3:]
        if not relative_text or relative_text.startswith("/"):
            fail("Git runtime status contains an unsafe path")
        relative = Path(relative_text)
        if ".." in relative.parts:
            fail("Git runtime status contains an unsafe path")
        records.append((status_code, relative_text))
        index += 1

        # Porcelain v1 -z emits a second pathname after rename/copy records.
        if "R" in status_code or "C" in status_code:
            if index >= len(fields):
                fail("Git runtime status contains an incomplete rename record")
            original_text = fields[index]
            if (
                not original_text
                or original_text.startswith("/")
                or ".." in Path(original_text).parts
            ):
                fail("Git runtime status contains an unsafe rename path")
            records.append(("ORIGINAL", original_text))
            index += 1
    return tuple(records)


def _runtime_status(environment: Environment) -> tuple[tuple[str, str], ...]:
    result = run(
        [
            GIT,
            "-C",
            str(environment.runtime),
            "status",
            "--porcelain=v1",
            "-z",
            "--untracked-files=no",
        ],
        user=environment.runtime_user,
    )
    return _parse_runtime_status(result.stdout)


def require_runtime_state(environment: Environment, expected: str) -> None:
    if git(environment.runtime, "symbolic-ref", "--quiet", "--short", "HEAD", user=environment.runtime_user) != environment.runtime_branch:
        fail("runtime is on an unexpected branch")
    if resolve(environment.runtime, "HEAD", user=environment.runtime_user) != expected:
        fail("runtime HEAD does not match the expected commit")

    status_records = _runtime_status(environment)
    if status_records:
        details = "; ".join(
            f"{status_code} {relative!r}"
            for status_code, relative in status_records
        )
        fail(f"runtime has tracked modifications: {details}")


def reset_runtime_preserving_operational_release(
    environment: Environment,
    *,
    expected_before: str,
    target: str,
) -> None:
    # The legacy function name is retained for the installed command contract.
    # Mutable Android release state now lives outside the Git worktree, so the
    # runtime must be clean and can be reset directly.
    require_runtime_state(environment, expected_before)
    run(
        [GIT, "-C", str(environment.runtime), "reset", "--hard", target],
        user=environment.runtime_user,
    )
    if environment.target_branch == "qa-main":
        harden_qa_runtime(environment, target)
    else:
        require_runtime_state(environment, target)


def _tracked_file_modes(repository: Path) -> dict[Path, int]:
    index = run(
        [GIT, "-C", str(repository), "ls-files", "--stage", "-z"],
    ).stdout
    tracked: dict[Path, int] = {}
    for record in index.split("\0"):
        if not record:
            continue
        try:
            metadata, relative_text = record.split("\t", 1)
            mode_text = metadata.split(" ", 1)[0]
        except ValueError:
            fail("Git index contains an invalid record")
        relative = Path(relative_text)
        if relative_text.startswith("/") or ".." in relative.parts:
            fail("Git index contains an unsafe path")
        if mode_text == "100644":
            file_mode = 0o640
        elif mode_text == "100755":
            file_mode = 0o750
        else:
            fail(f"repository contains unsupported tracked mode {mode_text}")
        tracked[relative] = file_mode
    return tracked


def harden_planning_checkout(expected: str) -> None:
    if not PLANNING_REPO.is_dir() or PLANNING_REPO.is_symlink():
        fail("planning checkout is missing or unsafe")
    if git(PLANNING_REPO, "symbolic-ref", "--quiet", "--short", "HEAD", user="alex") != "main":
        fail("planning checkout is not on main before hardening")
    if resolve(PLANNING_REPO, "HEAD", user="alex") != expected:
        fail("planning checkout does not match the expected commit before hardening")
    full_status = git(
        PLANNING_REPO,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
        user="alex",
    )
    if full_status:
        details = "; ".join(full_status.splitlines())
        fail(f"planning checkout is not clean before hardening: {details}")

    try:
        owner_uid = pwd.getpwnam("alex").pw_uid
        group_gid = grp.getgrnam("remihub-agent").gr_gid
    except KeyError:
        fail("planning checkout owner or group is missing")

    tracked = _tracked_file_modes(PLANNING_REPO)
    for directory, names, files in os.walk(PLANNING_REPO, topdown=True, followlinks=False):
        current = Path(directory)
        if current.is_symlink():
            fail(f"planning checkout contains an unexpected directory symlink: {current}")
        os.chown(current, owner_uid, group_gid)
        os.chmod(current, 0o2750)
        for name in names:
            child = current / name
            if child.is_symlink():
                fail(f"planning checkout contains an unexpected directory symlink: {child}")
        for filename in files:
            file_path = current / filename
            if file_path.is_symlink():
                fail(f"planning checkout contains an unexpected file symlink: {file_path}")
            os.chown(file_path, owner_uid, group_gid)
            os.chmod(file_path, 0o640)

    for relative, file_mode in tracked.items():
        file_path = PLANNING_REPO / relative
        if not file_path.is_file() or file_path.is_symlink():
            fail(f"planning checkout tracked file is missing or unsafe: {relative}")
        os.chown(file_path, owner_uid, group_gid)
        os.chmod(file_path, file_mode)

    if resolve(PLANNING_REPO, "HEAD", user="remihub-agent") != expected:
        fail("planning worker cannot resolve the hardened checkout")
    if git(
        PLANNING_REPO,
        "status",
        "--porcelain=v1",
        "--untracked-files=no",
        user="remihub-agent",
    ):
        fail("planning worker sees tracked modifications after hardening")
    worker_module = PLANNING_REPO / "backend" / "agent_worker.py"
    run(["/usr/bin/test", "-r", str(worker_module)], user="remihub-agent")


def harden_qa_runtime(environment: Environment, expected: str) -> None:
    if environment.target_branch != "qa-main":
        fail("runtime hardening is QA-only")
    if git(environment.runtime, "symbolic-ref", "--quiet", "--short", "HEAD") != environment.runtime_branch:
        fail("QA runtime is on an unexpected branch before hardening")
    if resolve(environment.runtime, "HEAD") != expected:
        fail("QA runtime HEAD does not match the expected commit before hardening")

    full_status = git(
        environment.runtime,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
    )
    if full_status:
        details = "; ".join(full_status.splitlines())
        fail(f"QA runtime is not clean before hardening: {details}")

    try:
        qa_gid = grp.getgrnam("remihub-qa-app").gr_gid
    except KeyError:
        fail("QA runtime group is missing")

    runtime = environment.runtime
    git_directory = runtime / ".git"
    if not git_directory.is_dir() or git_directory.is_symlink():
        fail("QA runtime Git directory is missing or unsafe")

    tracked = _tracked_file_modes(runtime)

    os.chown(runtime, 0, qa_gid)
    os.chmod(runtime, 0o2750)
    for directory, names, files in os.walk(runtime, topdown=True, followlinks=False):
        current = Path(directory)
        if current == runtime:
            names[:] = [name for name in names if name != ".git"]
        if current != runtime:
            if current.is_symlink():
                fail(f"QA runtime contains an unexpected directory symlink: {current}")
            os.chown(current, 0, qa_gid)
            os.chmod(current, 0o2750)
        for filename in files:
            path = current / filename
            if path.is_symlink():
                fail(f"QA runtime contains an unexpected file symlink: {path}")

    for relative, file_mode in tracked.items():
        path = runtime / relative
        if not path.is_file() or path.is_symlink():
            fail(f"QA runtime tracked file is missing or unsafe: {relative}")
        os.chown(path, 0, qa_gid)
        os.chmod(path, file_mode)

    for directory, _, files in os.walk(git_directory, followlinks=False):
        current = Path(directory)
        if current.is_symlink():
            fail("QA runtime Git directory contains a symlink")
        os.chown(current, 0, 0)
        os.chmod(current, 0o700)
        for filename in files:
            path = current / filename
            if path.is_symlink():
                fail("QA runtime Git metadata contains a symlink")
            os.chown(path, 0, 0)
            os.chmod(path, 0o600)

    require_runtime_state(environment, expected)


def verify_runtime(environment: Environment, args: list[str]) -> None:
    if len(args) != 1:
        fail("verify-runtime requires the expected commit")
    expected = commit(args[0])
    require_runtime_state(environment, expected)
    print(expected)


def ensure_runtime_tag(environment: Environment, rollback_ref: str, base: str) -> None:
    existing = run(
        [GIT, "-C", str(environment.runtime), "rev-parse", "--verify", "--quiet", f"refs/tags/{rollback_ref}^{{commit}}"],
        user=environment.runtime_user,
        check=False,
    )
    if existing.returncode == 0:
        if commit(existing.stdout.strip()) != base:
            fail("runtime rollback reference points to another commit")
        return
    run(
        [
            GIT,
            "-C",
            str(environment.runtime),
            "-c",
            "user.name=RemiHub Deployment",
            "-c",
            "user.email=remihub-deployment@invalid.local",
            "tag",
            "-a",
            rollback_ref,
            base,
            "-m",
            f"Rollback before {rollback_ref}",
        ],
        user=environment.runtime_user,
    )


def promote(environment: Environment, args: list[str]) -> None:
    if len(args) != 4:
        fail("promote requires candidate branch, candidate commit, base commit, and rollback reference")
    candidate_branch, candidate, base, rollback_ref = (
        branch(args[0]),
        commit(args[1]),
        commit(args[2]),
        tag(args[3]),
    )
    if resolve(environment.target_repo, f"refs/heads/{candidate_branch}") != candidate:
        fail("candidate branch does not resolve to the approved commit")
    if resolve(environment.target_repo, f"{candidate}^") != base:
        fail("candidate parent does not match the approved base")
    if resolve(environment.target_repo, environment.target_branch) != base:
        fail("deployment target branch advanced before runtime promotion")
    require_runtime_state(environment, base)
    ensure_runtime_tag(environment, rollback_ref, base)

    temporary_ref = f"refs/remotes/remihub-deployment/{candidate_branch}"
    run(
        [
            GIT,
            "-C",
            str(environment.runtime),
            "fetch",
            "--no-tags",
            str(environment.target_repo),
            f"refs/heads/{candidate_branch}:{temporary_ref}",
        ],
        user=environment.runtime_user,
    )
    if resolve(environment.runtime, temporary_ref, user=environment.runtime_user) != candidate:
        fail("runtime fetched an unexpected candidate commit")
    reset_runtime_preserving_operational_release(
        environment,
        expected_before=base,
        target=candidate,
    )


def restore(environment: Environment, args: list[str]) -> None:
    if len(args) != 2:
        fail("restore requires expected current and rollback commits")
    expected, rollback = commit(args[0]), commit(args[1])
    current = resolve(environment.runtime, "HEAD", user=environment.runtime_user)
    if current == rollback:
        require_runtime_state(environment, rollback)
        return
    if current != expected:
        fail("runtime is neither the expected candidate nor rollback commit")
    require_runtime_state(environment, expected)
    reset_runtime_preserving_operational_release(
        environment,
        expected_before=expected,
        target=rollback,
    )


def _require_frontend_artifact_path(environment: Environment, raw: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        fail("frontend artifact path must be absolute")
    resolved = path.resolve()
    artifact_root = environment.target_repo.parent / "artifacts"
    if artifact_root not in resolved.parents:
        fail("frontend artifact path is outside the deployment artifact root")
    if resolved.is_symlink() or not resolved.is_file():
        fail("frontend artifact path is missing or unsafe")
    return resolved


def _runtime_frontend_dist(environment: Environment) -> Path:
    path = environment.runtime / FRONTEND_DIST_RELATIVE
    parent = path.parent
    if parent.is_symlink() or not parent.is_dir():
        fail("runtime frontend-web directory is missing or unsafe")
    return path


def _safe_remove_tree(path: Path) -> None:
    if path.is_symlink():
        fail("refusing to remove symlinked frontend artifact path")
    if path.exists():
        shutil.rmtree(path)


def _snapshot_frontend_dist(environment: Environment, *, card_id: str, deployment_run_id: str) -> Path:
    dist = _runtime_frontend_dist(environment)
    environment.frontend_backup_root.mkdir(mode=0o750, parents=True, exist_ok=True)
    if environment.frontend_backup_root.is_symlink():
        fail("frontend backup root is unsafe")
    snapshot = environment.frontend_backup_root / f"{card_id}-{deployment_run_id}"
    if snapshot.exists():
        return snapshot
    if dist.exists():
        if dist.is_symlink() or not dist.is_dir():
            fail("runtime frontend dist is unsafe")
        shutil.copytree(dist, snapshot, symlinks=False)
    else:
        snapshot.mkdir(mode=0o750)
        (snapshot / ".remihub-dist-absent").write_text("absent\n", encoding="utf-8")
    return snapshot


def _install_archive_to_dist(environment: Environment, archive_path: Path) -> None:
    dist = _runtime_frontend_dist(environment)
    temporary = dist.parent / f".dist.remihub-new-{os.getpid()}"
    _safe_remove_tree(temporary)
    temporary.mkdir(mode=0o755)
    try:
        with tarfile.open(archive_path, "r:*") as archive:
            for member in archive.getmembers():
                target = temporary / member.name
                resolved = target.resolve()
                if temporary.resolve() != resolved and temporary.resolve() not in resolved.parents:
                    fail("frontend install archive path escapes dist")
                if member.isdir():
                    target.mkdir(mode=FRONTEND_DIR_MODE, parents=True, exist_ok=True)
                elif member.isfile():
                    target.parent.mkdir(mode=FRONTEND_DIR_MODE, parents=True, exist_ok=True)
                    source = archive.extractfile(member)
                    if source is None:
                        fail("frontend install archive file cannot be read")
                    with target.open("wb") as destination:
                        shutil.copyfileobj(source, destination)
                else:
                    fail("frontend install archive contains an unsupported entry type")
        for directory, names, files in os.walk(temporary, topdown=True, followlinks=False):
            current = Path(directory)
            if current.is_symlink():
                fail("frontend install extracted a symlinked directory")
            os.chmod(current, FRONTEND_DIR_MODE)
            for name in names:
                child = current / name
                if child.is_symlink():
                    fail("frontend install extracted a symlink")
            for filename in files:
                path = current / filename
                if path.is_symlink() or not path.is_file():
                    fail("frontend install extracted a special file")
                os.chmod(path, FRONTEND_FILE_MODE)
        old = dist.parent / f".dist.remihub-old-{os.getpid()}"
        _safe_remove_tree(old)
        if dist.exists():
            dist.replace(old)
        temporary.replace(dist)
        _safe_remove_tree(old)
    except BaseException:
        _safe_remove_tree(temporary)
        raise


def frontend_install(environment: Environment, args: list[str]) -> None:
    if len(args) != 6:
        fail("frontend-install requires manifest, archive, identity, candidate commit, card id, and deployment run id")
    manifest_path = _require_frontend_artifact_path(environment, args[0])
    archive_path = _require_frontend_artifact_path(environment, args[1])
    expected_identity = identity(args[2])
    candidate = commit(args[3])
    card_id = uuid(args[4], field="card id")
    deployment_run_id = uuid(args[5], field="deployment run id")
    if resolve(environment.runtime, "HEAD", user=environment.runtime_user) != candidate:
        fail("runtime HEAD does not match the frontend artifact candidate")
    verified = verify_frontend_archive(manifest_path, archive_path, expected_identity)
    _snapshot_frontend_dist(environment, card_id=card_id, deployment_run_id=deployment_run_id)
    _install_archive_to_dist(environment, archive_path)
    print(json.dumps({**verified, "status": "installed", "candidate_commit": candidate}, sort_keys=True))


def frontend_restore(environment: Environment, args: list[str]) -> None:
    if args:
        fail("frontend-restore accepts no additional arguments")
    dist = _runtime_frontend_dist(environment)
    snapshots = sorted(environment.frontend_backup_root.glob("*"), key=lambda path: path.stat().st_mtime, reverse=True) if environment.frontend_backup_root.is_dir() else []
    if not snapshots:
        print(json.dumps({"status": "not_applicable"}, sort_keys=True))
        return
    snapshot = snapshots[0]
    if snapshot.is_symlink() or not snapshot.is_dir():
        fail("frontend restore snapshot is unsafe")
    _safe_remove_tree(dist)
    if (snapshot / ".remihub-dist-absent").is_file():
        print(json.dumps({"status": "restored_absent", "snapshot": str(snapshot)}, sort_keys=True))
        return
    shutil.copytree(snapshot, dist, symlinks=False)
    print(json.dumps({"status": "restored", "snapshot": str(snapshot)}, sort_keys=True))


def frontend_verify(environment: Environment, args: list[str]) -> None:
    if len(args) != 2:
        fail("frontend-verify requires manifest and identity")
    manifest_path = _require_frontend_artifact_path(environment, args[0])
    expected_identity = identity(args[1])
    manifest = _frontend_manifest(manifest_path)
    if manifest.get("artifact_identity") != expected_identity:
        fail("frontend artifact identity does not match manifest")
    dist = _runtime_frontend_dist(environment)
    for entry in manifest["entries"]:
        path = dist / entry["path"]
        if entry["type"] == "directory":
            if path.is_symlink() or not path.is_dir():
                fail("frontend installed directory is missing")
        elif entry["type"] == "file":
            if path.is_symlink() or not path.is_file():
                fail("frontend installed file is missing")
            if path.stat(follow_symlinks=False).st_size != entry["size"]:
                fail("frontend installed file size mismatch")
            if _sha256_file(path) != entry["sha256"]:
                fail("frontend installed content hash mismatch")
        else:
            fail("frontend manifest contains an unsupported entry type")
    print(json.dumps({"status": "verified", "artifact_identity": expected_identity}, sort_keys=True))


def require_source_state(expected: str) -> None:
    if resolve(SOURCE_REPO, "refs/heads/main", user="remihub-agent") != expected:
        fail("implementation source main does not match the expected commit")
    if git(PLANNING_REPO, "symbolic-ref", "--quiet", "--short", "HEAD", user="alex") != "main":
        fail("planning checkout is not on main")
    if resolve(PLANNING_REPO, "HEAD", user="alex") != expected:
        fail("planning checkout does not match the expected commit")
    if git(PLANNING_REPO, "status", "--porcelain=v1", "--untracked-files=no", user="alex"):
        fail("planning checkout has tracked modifications")
    if resolve(PLANNING_REPO, "HEAD", user="remihub-agent") != expected:
        fail("planning worker cannot resolve the planning checkout")
    run(
        ["/usr/bin/test", "-r", str(PLANNING_REPO / "backend" / "agent_worker.py")],
        user="remihub-agent",
    )


def synchronize_sources(environment: Environment, args: list[str]) -> None:
    if environment is not ENVIRONMENTS["production"]:
        fail("source synchronization is production-only")
    if len(args) != 4:
        fail("synchronize-sources requires candidate branch, candidate commit, base commit, and rollback reference")
    candidate_branch, candidate, base, rollback_ref = (
        branch(args[0]), commit(args[1]), commit(args[2]), tag(args[3])
    )
    require_source_state(base)
    if resolve(environment.target_repo, f"refs/heads/{candidate_branch}") != candidate:
        fail("source synchronization candidate is unavailable")
    if resolve(environment.target_repo, environment.target_branch) != candidate:
        fail("production target branch has not advanced to the candidate")
    require_runtime_state(environment, candidate)

    temporary_ref = f"refs/remihub-deployment/{candidate_branch}"
    try:
        run(
            [
                GIT,
                "--git-dir",
                str(SOURCE_REPO),
                "fetch",
                "--no-tags",
                str(environment.target_repo),
                f"refs/heads/{candidate_branch}:{temporary_ref}",
            ],
            user="remihub-agent",
        )
        if resolve(SOURCE_REPO, temporary_ref, user="remihub-agent") != candidate:
            fail("implementation source fetched an unexpected commit")
        run(
            [GIT, "--git-dir", str(SOURCE_REPO), "update-ref", "refs/heads/main", candidate, base],
            user="remihub-agent",
        )
        run(
            [
                GIT,
                "-C",
                str(PLANNING_REPO),
                "fetch",
                "--no-tags",
                str(environment.runtime),
                environment.runtime_branch,
            ],
            user="alex",
        )
        run(
            [GIT, "-C", str(PLANNING_REPO), "reset", "--hard", candidate],
            user="alex",
        )
        harden_planning_checkout(candidate)
        require_source_state(candidate)
    except BaseException:
        run(
            [GIT, "--git-dir", str(SOURCE_REPO), "update-ref", "refs/heads/main", base, candidate],
            user="remihub-agent",
            check=False,
        )
        run(
            [GIT, "-C", str(PLANNING_REPO), "reset", "--hard", base],
            user="alex",
            check=False,
        )
        try:
            harden_planning_checkout(base)
        except BaseException:
            pass
        raise


def restore_sources(environment: Environment, args: list[str]) -> None:
    if environment is not ENVIRONMENTS["production"]:
        fail("source restoration is production-only")
    if len(args) != 2:
        fail("restore-sources requires expected current and rollback commits")
    expected, rollback = commit(args[0]), commit(args[1])

    source_current = resolve(SOURCE_REPO, "refs/heads/main", user="remihub-agent")
    if git(PLANNING_REPO, "symbolic-ref", "--quiet", "--short", "HEAD", user="alex") != "main":
        fail("planning checkout is not on main")
    if git(PLANNING_REPO, "status", "--porcelain=v1", "--untracked-files=no", user="alex"):
        fail("planning checkout has tracked modifications")
    planning_current = resolve(PLANNING_REPO, "HEAD", user="alex")

    allowed = {expected, rollback}
    if source_current not in allowed or planning_current not in allowed:
        fail("agent sources are neither the expected candidate nor rollback commit")
    if source_current == expected:
        run(
            [GIT, "--git-dir", str(SOURCE_REPO), "update-ref", "refs/heads/main", rollback, expected],
            user="remihub-agent",
        )
    if planning_current == expected:
        run(
            [GIT, "-C", str(PLANNING_REPO), "reset", "--hard", rollback],
            user="alex",
        )
    harden_planning_checkout(rollback)
    require_source_state(rollback)


def main() -> None:
    if os.geteuid() != 0:
        fail("must run as root through the dedicated sudo rule")
    os.umask(0o027)
    if len(sys.argv) < 3:
        fail("usage: ACTION ENVIRONMENT [validated arguments]")
    verify_git_safe_config()
    action = sys.argv[1]
    environment = verify_fixed_environment(sys.argv[2])
    args = sys.argv[3:]

    if action in {"start", "stop", "status"}:
        if args:
            fail(f"{action} accepts no additional arguments")
        if action == "status":
            result = run([SYSTEMCTL, "is-active", environment.service], check=False)
            print(result.stdout.strip() or "inactive")
            return
        run([SYSTEMCTL, action, environment.service])
        return
    if action == "harden-runtime":
        if len(args) != 1:
            fail("harden-runtime requires the expected commit")
        harden_qa_runtime(environment, commit(args[0]))
        return
    if action == "harden-planning":
        if environment is not ENVIRONMENTS["production"]:
            fail("planning hardening is production-only")
        if len(args) != 1:
            fail("harden-planning requires the expected commit")
        harden_planning_checkout(commit(args[0]))
        return
    if action == "verify-runtime":
        verify_runtime(environment, args)
        return
    if action == "promote":
        promote(environment, args)
        return
    if action == "restore":
        restore(environment, args)
        return
    if action == "frontend-install":
        frontend_install(environment, args)
        return
    if action == "frontend-restore":
        frontend_restore(environment, args)
        return
    if action == "frontend-verify":
        frontend_verify(environment, args)
        return
    if action == "synchronize-sources":
        synchronize_sources(environment, args)
        return
    if action == "restore-sources":
        restore_sources(environment, args)
        return
    fail("unsupported action")


if __name__ == "__main__":
    main()
