#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Sequence

VERSION = "1.0.0"
HEX40 = re.compile(r"^[0-9a-f]{40}$")
SAFE_ID = re.compile(r"^[A-Za-z0-9_.:-]{1,128}$")
CANONICAL_REPO = Path("/opt/remihub")
IMPLEMENTATION_REPO = Path("/opt/remihub-agent/repositories/remihub-implementation.git")
PLANNING_REPO = Path("/opt/remihub-agent/repositories/remihub-planning")
PRODUCTION_REPO = Path("/opt/remihub-agent/deployment/production/repository.git")
REQUEST_PATH = Path("/run/remihub-agent/github-sync/backend-request.json")
STATE_ROOT = Path("/var/lib/remihub-agent/github-sync/backend")
SERVICE = "remihub-agent-backend-github-sync.service"
SYNC_GROUP = "remihub-github-sync"
BRANCH = "main"
PRODUCTION_BRANCH = "production-main"
ALLOWED_DIRTY = " M deployments/release_version.json"
RELEASE_FILE = CANONICAL_REPO / "deployments/release_version.json"
HEALTH_URL = "http://127.0.0.1:8000/openapi.json"


class ControlFailure(RuntimeError):
    pass


def fail(message: str) -> None:
    raise ControlFailure(message)


def run(command: Sequence[str], *, user: str | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    actual = list(command)
    if user:
        actual = ["/usr/sbin/runuser", "-u", user, "--", *actual]
    result = subprocess.run(actual, text=True, encoding="utf-8", errors="replace", capture_output=True, check=False)
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"return code {result.returncode}"
        fail(f"command failed as {user or 'root'}: {' '.join(actual)}: {detail[:500]}")
    return result


def one_line(result: subprocess.CompletedProcess[str], field: str) -> str:
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(lines) != 1:
        fail(f"{field} did not resolve to exactly one line")
    return lines[0]


def git_worktree(repo: Path, *args: str, user: str | None = None) -> subprocess.CompletedProcess[str]:
    return run(["/usr/bin/git", "-c", f"safe.directory={repo}", "-C", str(repo), *args], user=user)


def git_bare(repo: Path, *args: str, user: str) -> subprocess.CompletedProcess[str]:
    return run(["/usr/bin/env", "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null", "/usr/bin/git", f"--git-dir={repo}", *args], user=user)


def sha256_path(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_request(payload: dict[str, Any]) -> None:
    REQUEST_PATH.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".backend-request.", dir=REQUEST_PATH.parent)
    temporary_path = Path(temporary)
    try:
        os.fchmod(descriptor, 0o640)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        run(["/usr/bin/chown", f"root:{SYNC_GROUP}", str(temporary_path)])
        os.replace(temporary_path, REQUEST_PATH)
        directory_fd = os.open(REQUEST_PATH.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary_path.exists():
            temporary_path.unlink()


def require_commit(value: str, field: str) -> str:
    if not HEX40.fullmatch(value):
        fail(f"{field} must be one lowercase 40-character commit hash")
    return value


def require_id(value: str, field: str) -> str:
    if not SAFE_ID.fullmatch(value):
        fail(f"{field} is invalid")
    return value


def verify_path(path: Path, *, directory: bool = True) -> None:
    try:
        metadata = path.lstat()
    except OSError as exc:
        fail(f"required path is unavailable: {path}: {exc}")
    if stat.S_ISLNK(metadata.st_mode):
        fail(f"required path must not be a symlink: {path}")
    if directory and not stat.S_ISDIR(metadata.st_mode):
        fail(f"required directory is invalid: {path}")
    if not directory and not stat.S_ISREG(metadata.st_mode):
        fail(f"required file is invalid: {path}")


def synchronize(candidate: str, base: str, card_id: str, deployment_run_id: str) -> dict[str, Any]:
    if os.geteuid() != 0:
        fail("must run as root through the dedicated sudo rule")
    candidate = require_commit(candidate, "candidate")
    base = require_commit(base, "base")
    card_id = require_id(card_id, "card_id")
    deployment_run_id = require_id(deployment_run_id, "deployment_run_id")

    for path in (CANONICAL_REPO, IMPLEMENTATION_REPO, PLANNING_REPO, PRODUCTION_REPO, STATE_ROOT, REQUEST_PATH.parent):
        verify_path(path)
    verify_path(RELEASE_FILE, directory=False)

    canonical_branch = one_line(git_worktree(CANONICAL_REPO, "symbolic-ref", "--quiet", "--short", "HEAD"), "canonical branch")
    canonical_commit = one_line(git_worktree(CANONICAL_REPO, "rev-parse", "--verify", "HEAD^{commit}"), "canonical commit")
    canonical_tree = one_line(git_worktree(CANONICAL_REPO, "rev-parse", "--verify", "HEAD^{tree}"), "canonical tree")
    implementation_commit = one_line(git_bare(IMPLEMENTATION_REPO, "rev-parse", "--verify", "refs/heads/main^{commit}", user="remihub-agent"), "implementation main")
    planning_branch = one_line(git_worktree(PLANNING_REPO, "symbolic-ref", "--quiet", "--short", "HEAD", user="alex"), "planning branch")
    planning_commit = one_line(git_worktree(PLANNING_REPO, "rev-parse", "--verify", "HEAD^{commit}", user="alex"), "planning commit")
    production_commit = one_line(git_bare(PRODUCTION_REPO, "rev-parse", "--verify", f"refs/heads/{PRODUCTION_BRANCH}^{{commit}}", user="remihub-deployer"), "production target")

    if canonical_branch != BRANCH or planning_branch != BRANCH:
        fail("canonical or planning checkout is not on main")
    observed = {canonical_commit, implementation_commit, planning_commit, production_commit}
    if observed != {candidate}:
        fail(f"protected repository refs do not all equal candidate {candidate}: {sorted(observed)}")
    git_worktree(CANONICAL_REPO, "cat-file", "-e", f"{base}^{{commit}}")
    git_worktree(CANONICAL_REPO, "merge-base", "--is-ancestor", base, candidate)
    status = git_worktree(CANONICAL_REPO, "status", "--porcelain=v1", "--untracked-files=all").stdout.rstrip("\n")
    if status != ALLOWED_DIRTY:
        fail("canonical worktree has an unexpected dirty state")

    health = run(["/usr/bin/curl", "--fail", "--silent", "--show-error", "--max-time", "20", HEALTH_URL])
    try:
        health_payload = json.loads(health.stdout)
    except json.JSONDecodeError as exc:
        fail("production health response is not JSON")
    if not isinstance(health_payload, dict) or "openapi" not in health_payload or "paths" not in health_payload:
        fail("production health response is missing OpenAPI fields")

    request_id = f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')}-{uuid.uuid4()}"
    payload = {
        "schema_version": 1,
        "control_version": VERSION,
        "request_id": request_id,
        "repository": "backend",
        "branch": BRANCH,
        "candidate_commit": candidate,
        "base_commit": base,
        "expected_tree": canonical_tree,
        "release_sha256": sha256_path(RELEASE_FILE),
        "card_id": card_id,
        "deployment_run_id": deployment_run_id,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    if REQUEST_PATH.exists():
        REQUEST_PATH.unlink()
    atomic_request(payload)

    service = run(["/usr/bin/systemctl", "start", SERVICE], check=False)
    result_path = STATE_ROOT / "results" / request_id / "result.json"
    if not result_path.is_file() or result_path.is_symlink():
        fail(f"GitHub sync service did not create its bound result: {service.stderr.strip()[:500]}")
    try:
        result = json.loads(result_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        fail("GitHub sync result is unreadable")
    if not isinstance(result, dict):
        fail("GitHub sync result is not an object")
    if result.get("request_id") != request_id or result.get("candidate_commit") != candidate:
        fail("GitHub sync result is not bound to this request")
    if service.returncode != 0 or result.get("status") != "verified" or result.get("remote_after") != candidate:
        reason = result.get("failure_reason") or service.stderr.strip() or "unknown GitHub sync failure"
        fail(f"GitHub sync failed after deployment remained successful: {reason}")

    # Re-prove all local durable boundaries after the network operation.
    if one_line(git_worktree(CANONICAL_REPO, "rev-parse", "--verify", "HEAD^{commit}"), "canonical commit after") != candidate:
        fail("canonical commit changed during GitHub synchronization")
    if one_line(git_bare(IMPLEMENTATION_REPO, "rev-parse", "--verify", "refs/heads/main^{commit}", user="remihub-agent"), "implementation main after") != candidate:
        fail("implementation main changed during GitHub synchronization")
    if one_line(git_worktree(PLANNING_REPO, "rev-parse", "--verify", "HEAD^{commit}", user="alex"), "planning commit after") != candidate:
        fail("planning checkout changed during GitHub synchronization")
    if one_line(git_bare(PRODUCTION_REPO, "rev-parse", "--verify", f"refs/heads/{PRODUCTION_BRANCH}^{{commit}}", user="remihub-deployer"), "production target after") != candidate:
        fail("production target changed during GitHub synchronization")
    REQUEST_PATH.unlink(missing_ok=True)
    return result


def main() -> int:
    try:
        if len(sys.argv) != 7 or sys.argv[1:3] != ["synchronize", "production"]:
            fail("usage: remihub-backend-github-sync-control synchronize production CANDIDATE BASE CARD_ID DEPLOYMENT_RUN_ID")
        result = synchronize(sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6])
        print(json.dumps(result, sort_keys=True))
        return 0
    except Exception as exc:
        print(f"remihub-backend-github-sync-control: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
